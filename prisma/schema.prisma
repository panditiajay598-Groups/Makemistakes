// Prisma schema for MakeMistakes (MongoDB Provider)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model EmailVerification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  lastSentAt  DateTime @default(now())
  hourlyCount Int      @default(1)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProblemStatement {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  slug                String?  @unique
  category            String?  @default("Product Design")
  difficulty          String?  @default("Medium")
  description         String?
  problemDescription  String?
  context             String?
  targetDemographics String?
  whyExists           String?
  whoExperiencesIt    String?
  whyCurrentFail      String?
  whySolvingMatters   String?
  impact              String?
  opportunity         String?
  pdfUrl              String?
  fileUrl             String?
  metadata            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  emailVerified Boolean   @default(true)
  name          String?
  role          String    @default("student")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription  Subscription?
  orders        PaymentOrder[]
  creditBalance AiCreditBalance?
}

model Subscription {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @unique @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String    @default("FREE") // "FREE", "PRO", "MAX"
  status           String    @default("ACTIVE") // "ACTIVE", "EXPIRED", "CANCELLED", "REFUNDED"
  startDate        DateTime  @default(now())
  expiryDate       DateTime?
  orderId          String?   @unique
  gatewayPaymentId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PaymentOrder {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  orderId          String    @unique
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail        String
  plan             String    // "PRO", "MAX"
  amount           Int       // Authoritative amount in paise
  currency         String    @default("INR")
  status           String    @default("CREATED") // "CREATED", "PAID", "FAILED", "REFUNDED"
  gateway          String    @default("RAZORPAY")
  gatewayOrderId   String?
  gatewayPaymentId String?   @unique
  gatewaySignature String?
  idempotencyKey   String?   @unique
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AiCreditBalance {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @unique @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalCredits     Int       @default(100)
  usedCredits      Int       @default(0)
  remainingCredits Int       @default(100)
  updatedAt        DateTime  @updatedAt
}

model AiCreditTransaction {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  amount       Int       // Positive for grant, negative for usage
  type         String    // "INITIAL_GRANT", "PURCHASE_GRANT", "NOVA_QUERY", "REFUND_DEDUCT", "EXPIRY_DEDUCT"
  referenceId  String?
  balanceAfter Int
  createdAt    DateTime  @default(now())
}
