# MakeMistakes Environment Variable Template for Vercel & Production

# Core Application Settings
DATABASE_URL="your-mongodb-atlas-connection-string"
JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
CORS_ORIGIN="https://your-vercel-domain.vercel.app"

# Email SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="MakeMistakes Team" <your-email@gmail.com>
REPLY_TO=support@makemistakes.in
RESEND_API_KEY=your-resend-api-key

# Nova AI Multi-Provider Fallback Credentials
GROQ_API_KEY=your-groq-api-key
NOVA_MODEL=qwen/qwen3.6-27b
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
