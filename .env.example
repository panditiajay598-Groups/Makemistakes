# SMTP Email Configuration
# To send real emails via Gmail or any SMTP provider, copy this file to .env.local and fill in your credentials.

# SMTP Server Settings (Zoho Mail India)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true

# Your SMTP Auth Credentials
SMTP_USER=support@makemistakes.in
SMTP_PASS=your-zoho-app-password

# Official Sender Display
SMTP_FROM="MakeMistakes Team" <support@makemistakes.in>
REPLY_TO="support@makemistakes.in"

# Nova AI (BuildOS mentor) — OpenAI-compatible
# Preferred for your setup: OpenRouter (key starts with sk-or-v1-)
OPENROUTER_API_KEY=
NOVA_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=MakeMistakes BuildOS Nova

# Alternatives:
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
